# Salin menjadi .env di folder ini, lalu isi semua nilai.

# Domain utama. Halaman daftar & admin di https://DOMAIN, pelanggan di https://<alamat>.DOMAIN
CLOUD_BASE_DOMAIN=mikrotal.id
CLOUD_PUBLIC_SCHEME=https

# WAJIB: teks acak minimal 32 karakter. Semua kunci pelanggan diturunkan dari sini.
# JANGAN diganti setelah ada pelanggan (password router & token login tidak bisa dibuka lagi).
# Buat dengan: openssl rand -hex 32
APP_SECRET=

# Admin platform (panel https://DOMAIN/admin). Password minimal 10 karakter.
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD=

# Email untuk Let's Encrypt (pemberitahuan sertifikat)
ACME_EMAIL=admin@mikrotal.id

LOG_LEVEL=info
