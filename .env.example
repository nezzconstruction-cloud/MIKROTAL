# Port HTTP aplikasi
PORT=8080
HOST=0.0.0.0
# WAJIB diganti di produksi: kunci untuk token login & enkripsi password router
APP_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
# Lokasi database SQLite
DATA_DIR=./data
# Akun admin pertama (dibuat otomatis saat database masih kosong)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Buat router simulasi saat pertama jalan (untuk demo/tanpa MikroTik asli)
SEED_DEMO=true

# ---- MIKROTAL Cloud (layanan berlangganan, lihat docs/CLOUD.md) ----
# MIKROTAL_MODE=cloud
# CLOUD_BASE_DOMAIN=mikrotal.id
# CLOUD_PUBLIC_SCHEME=https
